# ~/.config/fl27-mods/config.env  (python3 app/fl27paths.py --setup cria este arquivo)
# Obrigatório:
GAME_DIR="/caminho/para/drive_c/Program Files (x86)/SP Football Life 2027"
# Opcionais (o app tenta descobrir sozinho):
#WINEPREFIX="/caminho/do/prefixo"          # padrão: tudo antes de /drive_c
#WINE_BIN_DIR="/caminho/do/wine/bin"       # pasta com wine64 e wineserver (Lutris/Proton-GE); senão usa o do PATH
#BACKUP_ROOT="$HOME/FL27-backups"          # backups: ini/, saves/, original/, diagnostics/
#INI_BACKUP_DIR=  SAVES_BACKUP_DIR=  SAVES_DIR=  DIAG_DIR=   # sobrescrevem as pastas acima
#ORIG_INI=   # sider.ini original do SP (para separar "seus mods" da base); padrão: cópia feita no setup
#ORIG_EXE=   ORIG_DT13=   # exe/dt13 originais: o botão "voltar ao original" também os restaura
#ANIM_SCRIPT="/caminho/alternar_animacoes.sh"   # script próprio de troca de animações (mostra a aba Animações)
#GUIDE_PDF="/caminho/guia.pdf"
#WINEDLLOVERRIDES="steam_api64=n,b;ddraw=n,b;lsteamclient=d;d3d9,d3d10core,d3d11,dxgi=n,b"
